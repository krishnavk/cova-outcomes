{
  "name": "cova-outcomes",
  "version": "0.1.0",
  "private": true,
  "description": "Reports each closed pull request's outcome to CoreValue.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/index.cjs --legal-comments=none",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "check-dist": "npm run build && git diff --exit-code -- dist/"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "esbuild": "0.25.10",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
